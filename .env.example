# Server Configuration
PORT=8080

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/insurance_policy?sslmode=disable

# Redis Configuration (deployed on 6gb-bayu VM: 150.230.61.73)
REDIS_URL=redis://150.230.61.73:6379
# Local development:
# REDIS_URL=redis://localhost:6379

# Session Configuration
SESSION_SECRET=change-me-in-production

# LLM Configuration
LLM_ENDPOINT=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=http://100.103.220.104:20128/v1
EMBEDDINGS_MODEL=bge-m3

# Midtrans Payment Gateway
# Sandbox: Get keys from https://dashboard.sandbox.midtrans.com/settings/config_info
# Production: Get keys from https://dashboard.midtrans.com/settings/config_info
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SANDBOX_SERVER_KEY
MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_SANDBOX_CLIENT_KEY
MIDTRANS_IS_PRODUCTION=false

# Test Cards (Sandbox):
# Success: 4811 1111 1111 1114 | CVV: 123 | Exp: 12/28
# Failed:  4911 1111 1111 1113 | CVV: 123 | Exp: 12/28

# reCAPTCHA
RECAPTCHA_SECRET=

# CORS Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Sentry (optional)
SENTRY_DSN=

# SMTP Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# MinIO Object Storage Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=insurance-documents
MINIO_USE_SSL=false
